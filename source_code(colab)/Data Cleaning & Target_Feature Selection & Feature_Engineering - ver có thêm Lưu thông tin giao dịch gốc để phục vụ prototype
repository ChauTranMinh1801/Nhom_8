\n","        lower_bound, upper_bound,\n","        outlier_count, outlier_percentage\n","    ]\n","})\n","\n","print(\" AMOUNT OUTLIER SUMMARY\")\n","display(outlier_summary)\n","\n","print(\"\\nSample outlier transactions:\")\n","display(\n","    df.loc[\n","        outlier_mask,\n","        [\"step\", \"type\", \"amount\", \"isFraud\"]\n","    ].head(10)\n",")\n","\n","print(\"\\nDecision: Retain outliers for fraud detection.\")"],"metadata":{"id":"asQ2ub-95TNg","executionInfo":{"status":"ok","timestamp":1794602192720,"user_tz":-420,"elapsed":803,"user":{"displayName":"Nhàn Đỗ Thị Thanh","userId":"02551660777246791604"}},"colab":{"base_uri":"https://localhost:8080/","height":706},"outputId":"df18065e-260c-4f48-e02b-f3c01e876238"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":[" AMOUNT OUTLIER SUMMARY\n"]},{"output_type":"display_data","data":{"text/plain":["                   Metric          Value\n","0                      Q1   13389.570000\n","1                      Q3  208721.477500\n","2                     IQR  195331.907500\n","3             Lower Bound -279608.291250\n","4             Upper Bound  501719.338750\n","5           Outlier Count  338078.000000\n","6  Outlier Percentage (%)       5.313503"],"text/html":["\n","  <div id=\"df-4cf1504e-6e70-4e4e-a044-f44c99b1aa54\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Metric</th>\n","      <th>Value</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>Q1</td>\n","      <td>13389.570000</td>\n","    </tr>\n","    <tr>\n","      