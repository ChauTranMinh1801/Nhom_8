,"- Giá trị `step` không phải số nguyên dương.\n","- Loại giao dịch nằm ngoài năm nhóm quy định.\n","- Nhãn `isFraud` và `isFlaggedFraud` không thuộc tập `{0, 1}`.\n","- Mã tài khoản nguồn hoặc đích bị thiếu hay chỉ chứa khoảng trắng.\n"],"metadata":{"id":"nJP8j1FiSSYw"}},{"cell_type":"code","source":["\n","# Invalid Values Detection\n","# Xác định các cột dữ liệu dạng số\n","numeric_columns = [\n","    \"step\", \"amount\",\n","    \"oldbalanceOrg\", \"newbalanceOrig\",\n","    \"oldbalanceDest\", \"newbalanceDest\",\n","    \"isFraud\", \"isFlaggedFraud\"\n","]\n","# Các cột không được có giá trị âm\n","nonnegative_columns = [\n","    \"amount\",\n","    \"oldbalanceOrg\", \"newbalanceOrig\",\n","    \"oldbalanceDest\", \"newbalanceDest\"\n","]\n","# Danh sách loại giao dịch hợp lệ\n","valid_types = {\n","    \"PAYMENT\", \"TRANSFER\", \"CASH_OUT\",\n","    \"DEBIT\", \"CASH_IN\"\n","}\n","# Chuyển đổi tạm thời sang kiểu số để kiểm tra\n","# Không thay đổi giá trị trong DataFrame gốc\n","numeric_views = {\n","    col: pd.to_numeric(df[col], errors=\"coerce\")\n","    for col in numeric_columns\n","}\n","# Kiểm tra các giá trị số\n","invalid_rows = []\n","\n","for col in numeric_columns:\n","    values = numeric_views[col]\n","    # Phát hiện giá trị không thể chuyển đổi sang số\n","    non_numeric = df[col].notna() & values.isna()\n","    # Phát hiện giá trị âm trong các cột không cho phép\n","    negative = (\n","        values < 0\n","        if col in nonnegative_columns\n","        else pd.Series(False, index=df.index)\n","    )\n","    # Phát hiện giá trị vô hạn\n","    infinite = np.isinf(values)\n","\n","    invalid_rows.append({\n","        \"Column\": col,\n","        \"Non_Numeric\": int(non_numeric.sum()),\n","        \"Negative_Values\": int(negative.sum()),\n","        \"Infinite_Values\": int(infinite.sum())\n","    })\n","\n","invalid_numeric_summary = pd.DataFrame(invalid_rows)\n","# Kiểm tra miền giá trị\n","step_values = numeric_views[\"step\"]\n","fraud_values = numeric_views[\"isFraud\"]\n","flag_values = numeric_views[\"isFlaggedFraud\"]\n","\n","domain_checks = pd.DataFrame([\n","    {\n","        \"Validation\": \"Invalid transaction type\",\n","        \"Affected_Rows\": int(\n","            (~df[\"type\"].isin(valid_types)).sum()\n","        )\n","    },\n","    {\n","        \"Validation\": \"Invalid step (not positive integer)\",\n","        \"Affected_Rows\": int(\n","            (~np.isfinite(step_values) |\n","             (step_values <= 0) |\n","             (step_values % 1 != 0)).sum()\n","        )\n","    },\n","    {\n","        \"Validation\": \"Invalid isFraud label\",\n","        \"Affected_Rows\": int(\n","            (~fraud_values.isin([0, 1])).sum()\n","        )\n","    },\n","    {\n","        \"Validation\": \"Invalid isFlaggedFraud label\",\n","        \"Affected_Rows\": int(\n","            (~flag_values.isin([0, 1])).sum()\n","        )\n","    },\n","    {\n","        \"Validation\": \"Missing/blank nameOrig\",\n","        \"Affected_Rows\": int(\n","            (df[\"nameOrig\"].isna() |\n","             df[\"nameOrig\"].astype(\"string\").str.strip().eq(\"\")\n","            ).sum()\n","        )\n","    },\n","    {\n","        \"Validation\": \"Missing/blank nameDest\",\n","        \"Affected_Rows\": int(\n","            (df[\"nameDest\"].isna() |\n","             df[\"nameDest\"].astype(\"string\").str.strip().eq(\"\")\n","            ).sum()\n","        )\n","    }\n","])\n","\n","print(\"NUMERIC VALUE VALIDATION\")\n","display(invalid_numeric_summary)\n","\n","print(\"\\nDOMAIN VALIDATION\")\n","display(domain_checks)\n","\n","# Tổng hợp kết quả\n","tong_loi_so = int(\n","    invalid_numeric_summary[\n","        [\"Non_Numeric\", \"Negative_Values\", \"Infinite_Values\"]\n","    ].to_numpy().sum()\n",")\n","\n","tong_loi_mien = int(\n","    domain_checks[\"Affected_Rows\"].sum()\n",")\n","\n","print(\"\\n KẾT QUẢ TỔNG HỢP\")\n","print(f\"Lượt vi phạm kiểm tra số: {ton