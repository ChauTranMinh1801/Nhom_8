","# 3. Kiểm tra chỉ thêm đúng 2 feature\n","assert X_fe.shape[1] == X.shape[1] + 2\n","\n","assert set(X_fe.columns) - set(X.columns) == set(\n","    new_features\n",")\n","\n","# 4. Kiểm tra giữ nguyên cả 5 loại giao dịch\n","pd.testing.assert_series_equal(\n","    X_fe[\"type\"].value_counts().sort_index(),\n","    X[\"type\"].value_counts().sort_index()\n",")\n","\n","assert X_fe[\"type\"].nunique() == 5, (\n","    \"Không còn đủ 5 loại giao dịch!\"\n",")\n","\n","# 5. Kiểm tra feature mới không có NaN hoặc infinity\n","assert np.isfinite(\n","    X_fe[new_features].to_numpy()\n",").all(), \"Feature mới chứa NaN hoặc infinity!\"\n","\n","# 6. Đối chiếu công thức source mẫu trên TRANSFER/CASH_OUT\n","mask = X_fe[\"type\"].isin([\"TRANSFER\", \"CASH_OUT\"])\n","\n","source_orig = (\n","    X_fe.loc[mask, \"newbalanceOrig\"]\n","    + X_fe.loc[mask, \"amount\"]\n","    - X_fe.loc[mask, \"oldbalanceOrg\"]\n",")\n","\n","source_dest = (\n","    X_fe.loc[mask, \"oldbalanceDest\"]\n","    + X_fe.loc[mask, \"amount\"]\n","    - X_fe.loc[mask, \"newbalanceDest\"]\n",")\n","\n","assert np.allclose(\n","    X_fe.loc[mask, \"errorbalanceOrig\"],\n","    source_orig\n",")\n","\n","assert np.allclose(\n","    X_fe.loc[mask, \"errorbalanceDest\"],\n","    source_dest\n",")\n","\n","# 7. Tổng hợp kết quả\n","validation_summary = pd.DataFrame({\n","    \"Check\": [\n","        \"Row count unchanged\",\n","        \"Original features unchanged\",\n","        \"All 5 transaction types preserved\",\n","        \"Exactly 2 new features\",\n","        \"No NaN/Infinity in new features\",\n","        \"Source formulas matched for TRANSFER/CASH_OUT\"\n","    ],\n","    \"Result\": [\"PASS\"] * 6\n","})\n","\n","display(validation_summary)\n","\n","print(\"Final dataset shape:\", X_fe.shape)\n","print(\"\\nFeature statistics:\")\n","display(X_fe[new_features].describe().T)"],"metadata":{"id":"eU5uZe64COYo","executionInfo":{"status":"ok","timestamp":1794206401687,"user_tz":-420,"elapsed"