 0.01 do làm tròn số\n","nguong_sai_lech = 0.01\n","\n","# Lấy các cột số tiền và số dư đã được kiểm tra ở Cell trước\n","so_tien = numeric_views[\"amount\"]\n","so_du_nguon_truoc = numeric_views[\"oldbalanceOrg\"]\n","so_du_nguon_sau = numeric_views[\"newbalanceOrig\"]\n","so_du_dich_truoc = numeric_views[\"oldbalanceDest\"]\n","so_du_dich_sau = numeric_views[\"newbalanceDest\"]\n","\n","\n","# KIỂM TRA SỐ DƯ TÀI KHOẢN NGUỒN\n","\n","# Với CASH_IN: tiền được nạp vào tài khoản nguồn\n","# Với các giao dịch còn lại: tiền được trừ khỏi nguồn\n","la_cash_in = df[\"type\"] == \"CASH_IN\"\n","\n","so_du_nguon_du_kien = so_du_nguon_truoc - so_tien\n","\n","so_du_nguon_du_kien = so_du_nguon_du_kien.where(\n","    ~la_cash_in,\n","    so_du_nguon_truoc + so_tien\n",")\n","\n","# Tính mức chênh lệch giữa số dư dự kiến và thực tế\n","chenh_lech_nguon = (\n","    so_du_nguon_du_kien - so_du_nguon_sau\n",").abs()\n","\n","# Chỉ kiểm tra các giá trị số hữu hạn\n","nguon_hop_le = np.isfinite(chenh_lech_nguon)\n","\n","# Đánh dấu giao dịch có chênh lệch vượt ngưỡng\n","nguon_bat_thuong = (\n","    nguon_hop_le &\n","    (chenh_lech_nguon > nguong_sai_lech)\n",")\n","\n","# KIỂM TRA SỐ DƯ TÀI KHOẢN ĐÍCH\n","\n","# TRANSFER, CASH_OUT: dự kiến số dư đích tăng\n","# CASH_IN: dự kiến số dư tài khoản đối ứng giảm\n","# PAYMENT, DEBIT: không áp dụng công thức này\n","dich_tang = df[\"type\"].isin([\"TRANSFER\", \"CASH_OUT\"])\n","dich_giam = df[\"type\"] == \"CASH_IN\"\n","# Chỉ áp dụng cho các loại giao dịch đã quy định\n","duoc_kiem_tra_dich = dich_tang | dich_giam\n","\n","so_du_dich_du_kien = so_du_dich_truoc + so_tien\n","\n","so_du_dich_du_kien = so_du_dich_du_kien.where(\n","    ~dich_giam,\n","    so_du_dich_truoc - so_tien\n",")\n","# Tính chênh lệch tuyệt đối\n","chenh_lech_dich = (\n","    so_du_dich_du_kien - so_du_dich_sau\n",").abs()\n","\n","dich_hop_le = (\n","    duoc_kiem_tra_dich &\n","    np.isfinite(chenh_lech_dich)\n",")\n","\n","dich_bat_thuong = (\n","    dich_hop_le &\n","    (chenh_lech_dich > nguong_sai_lech)\n",")\n","\n","# THỐNG KÊ KẾT QUẢ THEO LOẠI GIAO DỊCH\n","\n","bang_theo_loai = pd.DataFrame({\n","    \"Tổng giao dịch\": df.groupby(\"type\").size(),\n","    \"Nguồn được kiểm tra\":\n","        nguon_hop_le.groupby(df[\"type\"]).sum(),\n","    \"Nguồn có chênh lệch\":\n","        nguon_bat_thuong.groupby(df[\"type\"]).sum(),\n","    \"Đích được kiểm tra\":\n","        dich_hop_le.groupby(df[\"type\"]).sum(),\n","    \"Đích có chênh lệch\":\n","        dich_bat_thuong.groupby(df[\"type\"]).sum()\n","}).fillna(0).astype(\"int64\")\n","# Tính tỷ lệ chênh lệch nguồn\n","bang_theo_loai[\"Tỷ lệ lệch nguồn (%)\"] = (\n","    bang_theo_loai[\"Nguồn có chênh lệch\"] /\n","    bang_theo_loai[\"Nguồn được kiểm tra\"].replace(0, np.nan)\n","    * 100\n",").round(2)\n","# Tính tỷ lệ chênh lệch đích\n","bang_theo_loai[\"Tỷ lệ lệch đích (%)\"] = (\n","    bang_theo_loai[\"Đích có chênh lệch\"] /\n","    bang_theo_loai[\"Đích được kiểm tra\"].replace(0, np.nan)\n","    * 100\n",").round(2)\n","\n","print(\"CHÊNH LỆCH SỐ DƯ THEO LOẠI GIAO DỊCH\")\n","display(bang_theo_loai)\n","\n","# BƯỚC 4: TỔNG HỢP KẾT QUẢ\n","\n","tong_hop_so_du = pd.DataFrame({\n","    \"Nội dung kiểm tra\": [\n","        \"Số dư tài khoản nguồn\",\n","        \"Số dư tài khoản đích\"\n","    ],\n","    \"Số giao dịch được kiểm tra\": [\n","        int(nguon_hop_le.sum()),\n","        int(dich_hop_le.sum())\n","    ],\n","    \"Số giao dịch có chênh lệch\": [\n","        int(nguon_bat_thuong.sum()),\n","        int(dich_bat_thuong.sum())\n","    ]\n","})\n","\n","tong_hop_so_du[\"Tỷ lệ chênh lệch (%)\"] = (\n","    tong_hop_so_du[\"Số giao dịch có chênh lệch\"] /\n","    tong_hop_so_du[\"Số giao dịch được kiểm tra\"]\n","    * 100\n",").round(2)\n","\n","print(\"\\nTỔNG HỢP KIỂM TRA SỐ DƯ\")\n","display(tong_hop_so_du)\n","\n","print(\"\\nNHẬN XÉT:\")\n","print(\"- Chênh lệch số dư không đồng nghĩa với lỗi dữ liệu.\")\n","print(\"- Công thức chỉ dùng để kiểm 