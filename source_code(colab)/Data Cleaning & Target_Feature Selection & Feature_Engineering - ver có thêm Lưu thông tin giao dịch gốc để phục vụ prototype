HÊNH LỆCH SỐ DƯ\n","# Mục đích:\n","# Kiểm tra xem các giao dịch chênh lệch số dư nguồn\n","# có thường xuất hiện số dư bằng 0 hay không.\n","\n","# Xác định các giao dịch có số dư nguồn bằng 0\n","so_du_truoc_0 = df[\"oldbalanceOrg\"].eq(0)\n","so_du_sau_0 = df[\"newbalanceOrig\"].eq(0)\n","\n","# Có ít nhất một trong hai số dư bằng 0\n","co_so_du_0 = so_du_truoc_0 | so_du_sau_0\n","\n","# Thống kê các giao dịch chênh lệch\n","bang_phan_tich = pd.DataFrame({\n","    \"Loại giao dịch\": df[\"type\"],\n","    \"Có chênh lệch\": nguon_bat_thuong,\n","    \"Số dư trước bằng 0\": so_du_truoc_0,\n","    \"Số dư sau bằng 0\": so_du_sau_0,\n","    \"Có ít nhất một số dư bằng 0\": co_so_du_0\n","})\n","\n","# Chỉ xét những giao dịch đã được đánh dấu chênh lệch\n","bang_lech = bang_phan_tich[\n","    bang_phan_tich[\"Có chênh lệch\"]\n","]\n","\n","# Tổng hợp theo từng loại giao dịch\n","ket_qua_so_du_0 = bang_lech.groupby(\n","    \"Loại giao dịch\"\n",").agg(\n","    So_giao_dich_lech=(\"Có chênh lệch\", \"size\"),\n","    So_du_truoc_0=(\"Số dư trước bằng 0\", \"sum\"),\n","    So_du_sau_0=(\"Số dư sau bằng 0\", \"sum\"),\n","    Co_it_nhat_mot_so_du_0=(\n","        \"Có ít nhất một số dư bằng 0\", \"sum\"\n","    )\n",")\n","\n","# Tính tỷ lệ giao dịch có số dư bằng 0\n","ket_qua_so_du_0[\"Ty_le_co_so_du_0_%\"] = (\n","    ket_qua_so_du_0[\"Co_it_nhat_mot_so_du_0\"] /\n","    ket_qua_so_du_0[\"So_giao_dich_lech\"] * 100\n",").round(2)\n","\n","print(\"=== CHÊNH LỆCH SỐ DƯ VÀ GIÁ TRỊ BẰNG 0 ===\")\n","display(ket_qua_so_du_0)\n","\n","# Tổng hợp toàn bộ dữ liệu\n","tong_lech = int(nguon_bat_thuong.sum())\n","tong_lech_co_0 = int((nguon_bat_thuong & co_so_du_0).sum())\n","\n","print(\"\\n=== TỔNG HỢP ===\")\n","print(f\"Tổng giao dịch chênh lệch: {tong_lech:,}\")\n","print(f\"Giao dịch chênh lệch có số dư bằng 0: {tong_lech_co_0:,}\")\n","\n","if tong_lech > 0:\n","    print(\n","        \"Tỷ lệ giao dịch chênh lệch có số dư bằng 0:\",\n","        f\"{tong_lech_co_0 / tong