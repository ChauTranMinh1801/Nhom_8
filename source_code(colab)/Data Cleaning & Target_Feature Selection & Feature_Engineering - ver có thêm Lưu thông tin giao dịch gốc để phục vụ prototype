cell trước\n","tong_loi_so = int(\n","    invalid_numeric_summary[\n","        [\"Non_Numeric\", \"Negative_Values\", \"Infinite_Values\"]\n","    ].to_numpy().sum()\n",")\n","\n","tong_loi_mien = int(domain_checks[\"Affected_Rows\"].sum())\n","\n","# Xác định giao dịch có ít nhất một số dư bằng 0\n","co_so_du_0_bat_ky = pd.Series(False, index=df.index)\n","\n","for cot in balance_columns:\n","    co_so_du_0_bat_ky |= numeric_views[cot].eq(0)\n","\n","# Tổng hợp kết quả phân tích số dư\n","so_lech_nguon = int(nguon_bat_thuong.sum())\n","so_lech_dich = int(dich_bat_thuong.sum())\n","\n","so_lech_nguon_co_0 = int(\n","    (nguon_bat_thuong & co_so_du_0).sum()\n",")\n","\n","so_gian_lan_trong_nhom_lech = int(\n","    (nguon_bat_thuong & df[\"isFraud\"].eq(1)).sum()\n",")\n","\n","# Tạo bảng tổng hợp\n","bang_quyet_dinh = pd.DataFrame([\n","    {\n","        \"Vấn đề\": \"Giá trị thiếu\",\n","        \"Số lượng\": so_dong_thieu,\n","        \"Quyết định\": \"Không cần xử lý\",\n","        \"Giải thích\": \"Không phát hiện giá trị thiếu\"\n","    },\n","    {\n","        \"Vấn đề\": \"Bản ghi trùng hoàn toàn\",\n","        \"Số lượng\": so_dong_trung,\n","        \"Quyết định\": \"Không cần xử lý\",\n","        \"Giải thích\": \"Không phát hiện bản ghi trùng hoàn toàn\"\n","    },\n","    {\n","        \"Vấn đề\": \"Lượt vi phạm kiểm tra dữ liệu\",\n","        \"Số lượng\": tong_loi_so + tong_loi_mien,\n","        \"Quyết định\": (\n","            \"Không cần xử lý\"\n","            if tong_loi_so + tong_loi_mien == 0\n","            else \"Cần kiểm tra thêm\"\n","        ),\n","        \"Giải thích\": \"Kiểm tra kiểu số và miền giá trị\"\n","    },\n","    {\n","        \"Vấn đề\": \"Giao dịch có ít nhất một số dư bằng 0\",\n","        \"Số lượng\": int(co_so_du_0_bat_ky.sum()),\n","        \"Quyết định\": \"Giữ nguyên\",\n","        \"Giải thích\": \"Giá trị 0 không mặc nhiên là lỗi\"\n","    },\n","    {\n","        \"Vấn đề\": \"Giao dịch ngoại lai theo IQR\",\n","  