    <property name="windowTitle">
      <string>AEGIS — Fraud Operations</string>
    </property>
    <property name="styleSheet">
      <string>
QWidget {font-family:Arial;font-size:13px;color:#17211B;}
QMainWindow, #rootStack, #background {background:#F2F9F3;}
QFrame#sidebar {background:#E3F398;}
QFrame#topbar {background:#222222;}
QFrame#card {background:white;border:1px solid #DAE3DE;border-radius:7px;}
QFrame#formPanel {background:#CDD9D7;border-radius:13px;}
QPushButton {background:#279E87;color:white;border:none;border-radius:7px;padding:10px 16px;}
QPushButton:hover {background:#208873;}
QPushButton:pressed {background:#00595C;}
QPushButton#dashboardButton, QPushButton#lookupButton, QPushButton#recordsButton {background:transparent;color:#17211B;text-align:left;padding:13px 16px;border-radius:4px;}
QPushButton#dashboardButton:hover, QPushButton#lookupButton:hover, QPushButton#recordsButton:hover {background:#D1DF8A;}
QPushButton#dashboardButton:checked, QPushButton#lookupButton:checked, QPushButton#recordsButton:checked {background:#B4BF96;}
QPushButton#logoutButton {background:#00595C;border-radius:22px;}
QPushButton#successClearButton, QPushButton#failClearButton {background:#7B7B7B;}
QPushButton#loginButton {background:black;color:#E3F398;font-size:22px;font-weight:bold;}
QPushButton#resetFiltersButton {background:transparent;color:#8A99AA;padding:7px 2px;}
QLineEdit {background:white;border:none;border-radius:11px;padding:9px 12px;min-height:25px;}
QLineEdit:focus {border:1px solid #279E87;}
QLineEdit#usernameEdit, QLineEdit#passwordEdit {border:1px solid #222222;border-radius:8px;padding:15px;font-size:16px;}
QLineEdit#globalSearchEdit {border-radius:2px;min-height:12px;padding:5px 10px;font-size:12px;}
QLineEdit#idFilterEdit {border:1px solid #00595C;border-radius:8px;font-size:11px;}
QComboBox {background:#F2F9F3;border:1px solid #00595C;border-radius:8px;padding:8px;font-size:11px;}
QComboBox::drop-down {border:none;width:18px;}
QComboBox QAbstractItemView {background:white;selection-background-color:#DCEBCE;selection-color:#17211B;}
QTableWidget {background:white;border:none;border-radius:9px;color:#344F69;font-size:10px;}
QTableWidget::item {border-bottom:1px solid #EDF1F0;padding:5px;}
QTableWidget::item:selected {background:#EAF4DE;color:#344F69;}
QHeaderView::section {background:#F8FAFA;color:#8998A9;border:none;padding:12px 5px;font-size:10px;}
QScrollArea {background:transparent;border:none;}

QTableWidget::item {padding:8px;} QHeaderView::section {padding:12px 8px;}
#loginPage,#shellPage,#dashboardPage,#successPage,#failPage,#recordsPage {background:#F2F9F3;}
#distributionCard,#typeChartCard {background:white;border:1px solid #DAE3DE;border-radius:7px;}

#recordsTable {font-size:11px;} #recordsTable QHeaderView::section {font-size:11px;}

QFrame[role="card"] {background:white;border:1px solid #DFE8DF;border-radius:12px;}
#dashboardContent,#recordsPage,#successPage,#failPage {background:#F2F9F3;}
QTableWidget {font-size:11px;border-radius:8px;background:white;selection-background-color:#EFF6E9;}
QHeaderView::section {background:#F7FAF7;color:#829086;font-size:11px;padding:10px 8px;border:none;border-bottom:1px solid #E7EEE7;}
QTableWidget::item {padding:8px;border-bottom:1px solid #EDF2EC;}
QLineEdit#idFilterEdit {background:white;border:1px solid #CADBD0;border-radius:8px;padding:7px 10px;}
QComboBox {background:white;border:1px solid #CADBD0;border-radius:8px;padding:8px 10px;font-size:12px;}
QComboBox:focus,QLineEdit:focus {border:1px solid #279E87;}
#success_step,#success_amount,#success_oldbalanceOrg,#success_newbalanceOrig,#success_oldbalanceDest,#success_newbalanceDest,
#fail_step,#fail_amount,#fail_oldbalanceOrg,#fail_newbalanceOrig,#fail_oldbalanceDest,#fail_newbalanceDest {background:#F5F8F4;border:1px solid #DDE7DC;border-radius:8px;padding:8px 11px;}
#success_type,#fail_type {background:#F5F8F4;border:1px solid #DDE7DC;border-radius:8px;padding:8px 10px;font-size:13px;}
#emptyStatePanel {background:#FCFDF9;border:1px dashed #C9D9C8;border-radius:12px;}
QScrollArea {background:transparent;border:none;}
QScrollBar:vertical {width:8px;background:#F2F9F3;}
QScrollBar::handle:vertical {background:#CBDACE;border-radius:4px;min-height:35px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical {height:0;}

QTableWidget::item {padding:0px 8px;border-bottom:1px solid #EDF2EC;}
</string>
